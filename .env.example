# Server Environment Mode ('development' | 'production')
NODE_ENV="development"

# Server Port
PORT=3000

# JWT Cryptographic Secret (REQUIRED in production)
# In development, a fallback key is provided with server warning.
# In production, server will refuse to boot if JWT_SECRET is not configured.
# Generate a strong key with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-key"

# Application Base URL
APP_URL="http://localhost:3000"

# Optional External Integrations
WHATSAPP_NUMBER="919876543210"
RAZORPAY_KEY_ID="rzp_test_sample12345678"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"
